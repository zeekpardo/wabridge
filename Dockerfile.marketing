# syntax=docker/dockerfile:1
#
# Production image for the WAGOAT marketing site (apps/marketing).
# Multi-stage: build the monorepo, then ship only Next.js's standalone output.
# Used by Railway (railway.marketing.toml -> builder = "dockerfile").
#
# Unlike the saas image this app has no database/Prisma — no openssl needed.

# ---- Stage 1: Build ----
FROM node:22-bookworm-slim AS builder

RUN npm install -g corepack@latest && corepack enable && corepack prepare pnpm@11.3.0 --activate

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile

# Public URLs are inlined into the client bundle at build time, so they must be
# present here (Railway passes them as --build-arg). The marketing site links out
# to the saas app and docs; NEXT_PUBLIC_MARKETING_URL is its own canonical URL.
ARG NEXT_PUBLIC_MARKETING_URL
ARG NEXT_PUBLIC_SAAS_URL
ARG NEXT_PUBLIC_DOCS_URL
# next build (with content-collections) can exceed Node's default heap in a
# container; raise it to avoid OOM/SIGABRT.
RUN NODE_OPTIONS="--max-old-space-size=4096" \
    NEXT_PUBLIC_MARKETING_URL=${NEXT_PUBLIC_MARKETING_URL} \
    NEXT_PUBLIC_SAAS_URL=${NEXT_PUBLIC_SAAS_URL} \
    NEXT_PUBLIC_DOCS_URL=${NEXT_PUBLIC_DOCS_URL} \
    pnpm --filter marketing build

# Fold static assets + the public dir into the standalone tree so the runtime
# serves them (Next standalone copies neither automatically).
RUN cp -r /app/apps/marketing/.next/static /app/apps/marketing/.next/standalone/apps/marketing/.next/static && \
    cp -r /app/apps/marketing/public /app/apps/marketing/.next/standalone/apps/marketing/public

# ---- Stage 2: Runtime ----
FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Preserve the apps/marketing/... path so the start command resolves.
COPY --from=builder /app/apps/marketing/.next/standalone ./apps/marketing/.next/standalone

EXPOSE 3000

CMD ["node", "apps/marketing/.next/standalone/apps/marketing/server.js"]
