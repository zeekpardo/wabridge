# =============================================================================
# WAGOAT integrations — WhatsApp (OpenWA) + GoHighLevel
# Each var shows the LOCAL value; the PROD (Railway) value is in the comment.
# CONFIG (URLs/ids) is recorded for both envs. SECRETS are placeholders only —
# real secret values live in your gitignored .env.local and in Railway. Never
# commit real secrets to git.
# =============================================================================

# --- OpenWA (unofficial WhatsApp API gateway; saas -> openwa) ---
# Base URL of the OpenWA service. The HOST differs per env (this is the bug that
# caused connectNumber 500s when it was left as http://:2785):
OPENWA_BASE_URL="http://localhost:2785"
#   prod: OPENWA_BASE_URL="http://openwa.railway.internal:2785"   (Railway private domain)
# API key saas sends as the `X-API-Key` header. It MUST equal OpenWA's admin key.
# OpenWA reads its key from API_MASTER_KEY (env) or, if unset, generates an
# `owa_k1_…` key on first boot and stores it in data/.api-key. So the openwa
# service needs API_MASTER_KEY (NOT OPENWA_API_KEY — that var is saas-side only).
# Local OpenWA and prod OpenWA have DIFFERENT keys.
OPENWA_API_KEY=""   # secret — local OpenWA key / prod: the Railway openwa owa_k1_… key
# Where OpenWA posts inbound webhooks back to saas:
WEBHOOK_BASE_URL="http://localhost:3000"
#   prod: WEBHOOK_BASE_URL="http://saas.railway.internal:3000"   (Railway private domain)

# --- GoHighLevel marketplace app ---
# ONE marketplace app is shared across envs; only the redirect URI differs.
# In the marketplace app, register these URLs (swap the tunnel host for local):
#   Redirect URL(s):            https://<tunnel>.trycloudflare.com/oauth/callback   (local)
#                               https://app.wagoat.com/oauth/callback              (prod)
#   Webhook URL:                https://app.wagoat.com/api/webhooks/gohighlevel
#   Conversation Delivery URL:  https://app.wagoat.com/api/providers/sms/outbound
#   Custom Page URL:            https://app.wagoat.com/embedded/{orgSlug}/whatsapp/{subaccountId}
GOHIGHLEVEL_CLIENT_ID=""
GOHIGHLEVEL_CLIENT_SECRET=""              # secret — do not commit
GOHIGHLEVEL_REDIRECT_URI="https://<tunnel>.trycloudflare.com/oauth/callback"
#   prod: GOHIGHLEVEL_REDIRECT_URI="https://app.wagoat.com/oauth/callback"
# Provider ids created inside the GHL marketplace app (custom channel / SMS takeover):
GOHIGHLEVEL_CONVERSATION_PROVIDER_ID=""
GOHIGHLEVEL_SMS_PROVIDER_ID=""
# Ed25519 public key that verifies GHL webhook / Delivery-URL signatures:
GOHIGHLEVEL_WEBHOOK_PUBLIC_KEY=""         # do not commit
# Iframe embedding allowlist for /embedded/* (space-separated). Same both envs:
GHL_FRAME_ANCESTORS="https://app.gohighlevel.com https://*.leadconnectorhq.com"

# GoHighLevel embedded Custom Page (SSO) — from the marketplace app
GHL_SSO_KEY=""                            # secret — do not commit
# Secret for signing embedded-session tokens (defaults to BETTER_AUTH_SECRET)
EMBEDDED_JWT_SECRET=""                     # secret — do not commit

# --- other WAGOAT server secrets (placeholders — real values in .env.local / Railway) ---
INTEGRATION_ENCRYPTION_KEY=""             # AES-256 (64 hex) for GHL token storage
CRON_SECRET=""                            # guards POST /api/cron/whatsapp-reconcile
