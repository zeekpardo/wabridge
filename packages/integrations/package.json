{
	"name": "@repo/integrations",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./index.ts",
	"types": "./**/.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./index.ts"
		},
		"./crypto": {
			"types": "./lib/crypto.ts",
			"default": "./lib/crypto.ts"
		},
		"./webhook-verify": {
			"types": "./lib/gohighlevel/webhook-verify.ts",
			"default": "./lib/gohighlevel/webhook-verify.ts"
		}
	},
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@repo/database": "workspace:*",
		"@repo/logs": "workspace:*",
		"ioredis": "catalog:"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
