datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  role                     String?
  banned                   Boolean?
  banReason                String?
  banExpires               DateTime?
  onboardingComplete       Boolean                      @default(false)
  paymentsCustomerId       String?
  locale                   String?
  twoFactorEnabled         Boolean?
  lastActiveOrganizationId String?
  sessions                 Session[]
  accounts                 Account[]
  passkeys                 Passkey[]
  invitations              Invitation[]
  purchases                Purchase[]
  members                  Member[]
  twofactors               TwoFactor[]
  notifications            Notification[]
  notificationPreferences  UserNotificationPreference[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]

  // An agency (Organization) owns many subaccounts (one per GHL location).
  subaccounts           Subaccount[]
  // Denormalized org back-relations (kept for cross-subaccount/admin queries).
  whatsAppSessions      WhatsAppSession[]
  whatsAppMessages      WhatsAppMessage[]
  whatsAppConversations WhatsAppConversation[]

  @@unique([slug])
  @@map("organization")
}

/// A subaccount is one GoHighLevel location under an agency (Organization).
/// All WhatsApp/GHL data is scoped to a subaccount; the agency is the tenant.
model Subaccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  // The GHL location id, set when this subaccount is linked to GoHighLevel.
  ghlLocationId  String?      @unique
  // How the subaccount was created: "manual" | "ghl". Set once, never changed.
  provisioningSource String   @default("manual")
  status         String       @default("active")
  // White-label overrides (logo, brand name, support URL) for this subaccount.
  whiteLabel     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  goHighLevelConnection GoHighLevelConnection?
  whatsAppSessions      WhatsAppSession[]
  whatsAppMessages      WhatsAppMessage[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppSettings      WhatsAppSettings?
  ownerDefaultNumbers   OwnerDefaultNumber[]

  @@index([organizationId])
  @@map("subaccount")
}

model GoHighLevelConnection {
  id                     String       @id @default(cuid())
  subaccountId           String       @unique
  subaccount             Subaccount   @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  locationId             String
  companyId              String?
  userId                 String?
  accessToken            String       @db.Text
  refreshToken           String       @db.Text
  tokenExpiresAt         DateTime
  // The WhatsApp custom-channel provider (Option A — "add channel").
  conversationProviderId String?
  // The SMS-replace provider (Option B — takes over the native SMS channel).
  smsProviderId          String?
  webhooksEnabled        Boolean      @default(false)
  firstSyncInProgress    Boolean      @default(false)
  needsReconnect         Boolean      @default(false)
  // JSON: { allowedSources: string[] }
  syncConfig             String?      @db.Text
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@map("go_high_level_connection")
}

model WhatsAppSession {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subaccountId    String
  subaccount      Subaccount        @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  openwaSessionId String            @unique
  openwaName      String            @unique
  workerBaseUrl   String
  label           String?
  phone           String?
  jid             String?
  status          String
  webhookSecret   String
  needsQr         Boolean           @default(true)
  // Sending priority (1 = highest). Used for default routing and #switch|N.
  priority        Int               @default(0)
  lastError       String?           @db.Text
  connectedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        WhatsAppMessage[]
  activeConversations WhatsAppConversation[] @relation("ConversationActiveSession")
  ownerDefaultNumbers OwnerDefaultNumber[]

  @@index([organizationId])
  @@index([subaccountId])
  @@map("whatsapp_session")
}

model WhatsAppMessage {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subaccountId   String
  subaccount     Subaccount      @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  sessionId      String
  session        WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction      String
  waMessageId    String?
  chatId         String
  fromMe         Boolean
  body           String?         @db.Text
  type           String
  status         String?
  // The waMessageId this message quotes/replies to, if any.
  quotedMessageId String?
  // Per-message reactions: array of { emoji, senderId, fromMe }. One reaction
  // per sender (a sender's new reaction replaces their prior one).
  reactions      Json?
  // Set when the message was revoked/deleted (inbound revoke or our delete).
  deleted        Boolean         @default(false)
  // Provenance for the hub: where this message entered our store.
  // "contact" = inbound from WhatsApp, "ghl" = GHL-originated outbound (SMS
  // takeover / workflow / bulk), "app" = sent from our embedded messenger.
  origin         String          @default("contact")
  // Who sent an outbound message from our app — the acting staff user (app
  // login or GHL-embedded SSO user). Denormalized `sentByName` so the thread
  // renders the sender without a per-message user/CRM lookup. Null for inbound
  // and for GHL-native/automation sends (no acting app user).
  sentByUserId   String?
  sentByName     String?
  // The group member who sent an inbound message — their display name and
  // phone (`<digits>@c.us` → digits). Set only for inbound group messages so
  // the thread can label who spoke; null for 1:1 chats and outbound.
  authorName     String?
  authorPhone    String?
  // GHL's message id once mirrored, for status updates + echo de-duplication.
  ghlMessageId   String?
  ghlSynced      Boolean         @default(false)
  idempotencyKey String?         @unique
  timestamp      DateTime
  createdAt      DateTime        @default(now())

  // One row per WhatsApp message per session: the API-send write and the
  // message.sent webhook echo race, and check-then-insert can't close that
  // window. NULLs are distinct in Postgres, so id-less rows are unaffected.
  @@unique([sessionId, waMessageId])
  @@index([sessionId, timestamp])
  @@index([organizationId, chatId, timestamp])
  @@index([subaccountId, chatId, timestamp])
  @@index([ghlMessageId])
  @@map("whatsapp_message")
}

model WhatsAppConversation {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subaccountId       String
  subaccount         Subaccount       @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  // The contact's chat id (e.g. 15551234567@c.us). One thread per contact.
  chatId             String
  contactName        String?
  // ─── Contact / CRM prewiring (synced with GoHighLevel once connected) ───
  // The linked GHL contact id, when this thread has been matched to a contact.
  ghlContactId       String?
  // The GHL conversation that mirrors this thread. Cached with ghlContactId so
  // message projections cost zero extra GHL API calls after the first message.
  ghlConversationId  String?
  // For a WhatsApp GROUP mirrored as a synthetic CRM contact: the placeholder
  // phone we assign so the CRM can hold the group as a contact, and CRM→WA sends
  // can reverse-map back to this group thread. Null for ordinary 1:1 threads.
  crmPlaceholderPhone String?
  // The org member (user id) who owns this contact.
  ownerId            String?
  // Contact tags. Held locally now; pushed to / pulled from GHL when connected.
  tags               Json?
  // Which of the org's numbers currently replies (set by inbound reply-lock or #switch).
  activeSessionId    String?
  activeSession      WhatsAppSession? @relation("ConversationActiveSession", fields: [activeSessionId], references: [id], onDelete: SetNull)
  lastMessageAt      DateTime?
  lastMessagePreview String?          @db.Text
  lastDirection      String?
  unreadCount        Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([subaccountId, chatId])
  @@index([subaccountId, lastMessageAt])
  @@index([subaccountId, crmPlaceholderPhone])
  @@map("whatsapp_conversation")
}

model WhatsAppSettings {
  id            String     @id @default(cuid())
  subaccountId  String     @unique
  subaccount    Subaccount @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  // Global spintax variables, e.g. { "SPINTAX_1": ["Hi", "Hello"], ... }.
  globalSpintax Json?
  // Saved bulk-message templates: [{ id, name, text, updatedAt }, ...].
  messageTemplates Json?
  // Whether the WhatsApp Groups feature is enabled for this subaccount (hides the Groups tab when off).
  // Off by default — a subaccount opts in from Settings. (Existing rows keep their prior value.)
  groupsEnabled Boolean    @default(false)
  // Tag applied to a CRM contact when a message is sent to a number that isn't on WhatsApp.
  // Null/empty disables the feature.
  noWhatsappTag String?
  // Staff triggers: [{ phrase, tag }, ...] — when an outbound message contains `phrase`
  // (case-sensitive), `tag` is added to the CRM contact.
  staffTriggers Json?
  // How a NEW contact's sticky sending number is chosen when the owner initiates first (no inbound yet):
  //   "owner"       — the initiating owner's default number (OwnerDefaultNumber), then the org default.
  //   "distributed" — the least-loaded of the subaccount's ready numbers, so contacts spread evenly.
  // Only affects the owner-initiated first pick; inbound reply-lock and the set-once stickiness are unchanged.
  numberAssignmentStrategy String @default("owner")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("whatsapp_settings")
}

/// An agency member's preferred sending number within a subaccount — the default
/// WhatsAppSession used when that member starts a new conversation.
model OwnerDefaultNumber {
  id           String          @id @default(cuid())
  subaccountId String
  subaccount   Subaccount      @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  // The assignable owner's id — the SAME id space as listContactOwners and
  // contact ownership: a GHL location user id when GHL is connected, else the
  // agency member's app user id. Not an FK (a GHL user id has no local row).
  ownerId      String
  sessionId    String
  session      WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([subaccountId, ownerId])
  @@index([subaccountId])
  @@index([sessionId])
  @@map("owner_default_number")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  type           PurchaseType
  customerId     String
  subscriptionId String?       @unique
  priceId        String
  status         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
  @@map("purchase")
}

enum NotificationTarget {
  IN_APP
  EMAIL
}

enum NotificationType {
  WELCOME
  APP_UPDATE
  WHATSAPP_SESSION_DISCONNECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}")
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("notification")
}

model UserNotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  target    NotificationTarget
  createdAt DateTime           @default(now())

  @@unique([userId, type, target])
  @@map("user_notification_preference")
}
