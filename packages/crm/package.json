{
	"name": "@repo/crm",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./index.ts",
	"types": "./**/.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./index.ts"
		},
		"./providers": {
			"types": "./lib/providers/gohighlevel.ts",
			"default": "./lib/providers/gohighlevel.ts"
		}
	},
	"scripts": {
