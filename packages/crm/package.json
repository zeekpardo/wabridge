		"test:watch": "vitest"
	},
	"dependencies": {
		"@repo/database": "workspace:*",
		"@repo/integrations": "workspace:*",
		"@repo/logs": "workspace:*",
		"@repo/whatsapp": "workspace:*"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
